local function say(t) pcall(function() service.speak(t) end) end
local function later(ms, fn)
  if type(task) == "function" then
    task(ms, fn)
  else
    local h = Handler(Looper.getMainLooper())
    h.postDelayed(luajava.createProxy("java.lang.Runnable", {run = fn}), ms)
  end
end
local started = false
local introPlayer = nil
local mainFn, mainErr = nil, nil
local function stopIntro()
  if introPlayer then
    pcall(function() introPlayer.stop() end)
    pcall(function() introPlayer.release() end)
    introPlayer = nil
  end
end
local function prepMain()
  if mainFn or mainErr then return end
  local ok, err = pcall(function()
    local data = luajava.bindClass("android.util.Base64").decode(table.concat(PAYLOAD), 0)
    local inf = Inflater()
    inf.setInput(data)
    local baos = ByteArrayOutputStream()
    local buf = Array.newInstance(Byte.TYPE, 65536)
    local guard = 0
    while not inf.finished() and guard < 2000 do
      local n = tonumber(inf.inflate(buf))
      if n > 0 then baos.write(buf, 0, n)
      elseif inf.needsInput() or inf.needsDictionary() then break end
      guard = guard + 1
    end
    pcall(function() inf["end"]() end)
    local code = tostring(baos.toString("UTF-8"))
    local fn, e = load(code, "=media_studio", "t", _ENV)
    if not fn then error("load failed: " .. tostring(e)) end
    mainFn = fn
  end)
  if not ok then mainErr = tostring(err) end
end
local function runMain()
  if started then return end
  started = true
  stopIntro()
  prepMain()
  if mainErr then say("Plugin could not start. " .. mainErr) return end
  local ok, err = pcall(mainFn)
  if not ok then say("Plugin could not start. " .. tostring(err)) end
end
local function tlog(m) pcall(function() TUNE_LOG = tostring(TUNE_LOG or "") .. m .. "; " end) end
local function startTune(path, mode)
  local mp = MediaPlayer()
  introPlayer = mp
  mp.setDataSource(path)
  if mode == 2 and sdk >= 21 then
    pcall(function()
      local ab = AudioAttributes.Builder()
      ab.setUsage(AudioAttributes.USAGE_MEDIA)
      ab.setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
      mp.setAudioAttributes(ab.build())
    end)
  end
  mp.prepare()
  mp.setOnCompletionListener{onCompletion=function()
    tlog("completed")
    later(1000, runMain)
  end}
  mp.setOnErrorListener{onError=function(m, w, x) tlog("player error " .. tostring(w) .. "/" .. tostring(x)) runMain() return true end}
  mp.start()
  return mp
end
local function tuneMoving(mp)
  local p1 = 0
  pcall(function() p1 = tonumber(mp.getCurrentPosition()) or 0 end)
  return p1
end
local function playIntro()
  local path = service.getCacheDir().getAbsolutePath() .. "/intro_tune_ms3.m4a"
  local data = luajava.bindClass("android.util.Base64").decode(table.concat(INTRO_B64), 0)
  local need = Array.getLength(data)
  local have = 0
  local fh = io.open(path, "rb")
  if fh then have = fh:seek("end") or 0 fh:close() end
  if have ~= need then
    local fo = FileOutputStream(path)
    fo.write(data, 0, need)
    fo.flush()
    fo.close()
    tlog("file written " .. need)
  end
  local mp
  local ok, e = pcall(function() mp = startTune(path, 1) end)
  if not ok then
    tlog("start1 failed: " .. tostring(e))
    pcall(function() if introPlayer then introPlayer.release() end end)
    introPlayer = nil
    ok, e = pcall(function() mp = startTune(path, 2) end)
    if not ok then tlog("start2 failed: " .. tostring(e)) error("tune not started") end
  end
  local dur = 13000
  pcall(function()
    local d = mp.getDuration()
    if d and d > 0 then dur = d end
  end)
  tlog("duration " .. dur)
  later(150, function() if not started then pcall(prepMain) end end)
  -- if the position is not moving after 1.5 s, the tune is not really playing: open now
  later(1500, function()
    if started or not introPlayer then return end
    local playing = false
    pcall(function() playing = introPlayer.isPlaying() end)
    local pos = tuneMoving(introPlayer)
    tlog("check pos " .. pos .. " playing " .. tostring(playing))
    if not playing or pos < 100 then runMain() end
  end)
  later(dur + 3000, runMain)
end
if not pcall(playIntro) then runMain() end
return true